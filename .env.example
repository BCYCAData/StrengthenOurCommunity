VITE_SUPABASE_URL=<Your supabase URL>
VITE_SUPABASE_ANON_KEY=<Your Supabase Anon Key>
VITE_SUPABASE_REDIRECT_URL_BASE=http://localhost:5173

# Optional backpack worker; keep disabled until policy, baseline and contacts are approved.
# These are server-only variables. Never add a VITE_ prefix to secrets.
BACKPACK_ASSESSMENT_ENABLED=false
BACKPACK_EMAIL_WORKER_ENABLED=false
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
RESEND_API_KEY=
BACKPACK_WORKER_SECRET=
# Coordinator backend uses the signed-in user's JWT and a DB-managed allowlist.
BACKPACK_ADMIN_ENABLED=false

# Participant status is read-only except its separate notice dismissal record.
BACKPACK_PARTICIPANT_STATUS_ENABLED=false
